<Project>
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>Fang</Authors>
    <Description>Multi-platform message push library for .NET</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/fang/Fang.Notification</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fang/Fang.Notification</RepositoryUrl>
    <PackageTags>push;notification;dingtalk;feishu;wecom;teams;email</PackageTags>
    <Nullable>disable</Nullable>
  </PropertyGroup>
</Project>
